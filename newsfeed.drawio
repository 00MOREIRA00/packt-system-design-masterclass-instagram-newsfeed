        <mxCell id="AKepsDW-8kDpoW2XCkPR-32" edge="1" parent="1" source="AKepsDW-8kDpoW2XCkPR-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.01;entryY=0.517;entryDx=0;entryDy=0;entryPerimeter=0;curved=1;" target="AKepsDW-8kDpoW2XCkPR-27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AKepsDW-8kDpoW2XCkPR-33" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="5" vertex="1">
          <mxGeometry height="30" width="60" x="270" y="2395" as="geometry" />
        </mxCell>
        <mxCell id="AKepsDW-8kDpoW2XCkPR-34" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="7 busca post" vertex="1">
          <mxGeometry height="30" width="80" x="940" y="2265" as="geometry" />
        </mxCell>
        <mxCell id="AKepsDW-8kDpoW2XCkPR-35" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="8 busca seguidores&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="100" x="940" y="2355" as="geometry" />
        </mxCell>
        <mxCell id="AKepsDW-8kDpoW2XCkPR-36" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="9 grava no feed de cada seguidor" vertex="1">
          <mxGeometry height="30" width="100" x="930" y="2495" as="geometry" />
        </mxCell>
        <mxCell id="AKepsDW-8kDpoW2XCkPR-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="10 atualiza cache" vertex="1">
          <mxGeometry height="30" width="90" x="945" y="2627" as="geometry" />
        </mxCell>
        <mxCell id="AKepsDW-8kDpoW2XCkPR-38" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Exemplo&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;font&gt;-&amp;nbsp; Ana publicou um post, e Bruna e Carla seguem a Ana.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;1. O Newsfeed Generator busca o post da Ana no PostsDB&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;2. Consulta o FollowDB e descobre que os seguidores são Bruna e Carla&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;3. Atualiza o FeedsDB, colocando esse post no feed de cada um dos dois:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Feed da Bruna:&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;[novo post da Ana, posts anteriores ...]&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Feed da Carla:&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;[novo post da Ana, posts anteriores ...]&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;4. Atualiza também o feeds cache com esses feeds&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;&lt;b&gt;Quem faz esse serviço é o newsfeed generator service.&lt;/b&gt; Os bancos não enviam os dados uns para os outros sozinhos. Esse processamento acontece em segundo plano, a partir do evento que foi colocado na fila quando Ana publicou.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;Quando Bruna abre seu aplicativo o caminho fica simples:&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;1. Bruna pede seu feed&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;2. Newsfeed reader consulta o feeds cache usando o ID da Bruna&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;3. Recebe o feed já preparado e retorna para Bruna&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;Se não tiver no cache faz a consulta&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="420" width="420" x="150" y="2525" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Create Image/Video Post" id="r7wIWq6HeYknyt5SENNV">
