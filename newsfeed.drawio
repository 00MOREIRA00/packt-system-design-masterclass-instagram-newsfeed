        </mxCell>
        <mxCell id="AKepsDW-8kDpoW2XCkPR-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Feeds Cache&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="80" x="1035.71" y="2657" as="geometry" />
