          <mxGeometry height="30" width="110" x="835" y="1079.5" as="geometry" />
        </mxCell>
        <mxCell id="eXjkPu2F_RSxJcqSW4fp-24" parent="ZPjAD2DASo2O7Q2uIRb9-1" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" value="Object Storage" vertex="1">
          <mxGeometry height="70" width="96" x="770" y="1145" as="geometry" />
        </mxCell>
        <mxCell id="eXjkPu2F_RSxJcqSW4fp-26" parent="ZPjAD2DASo2O7Q2uIRb9-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="se não tiver no cdn" vertex="1">
          <mxGeometry height="30" width="130" x="590" y="1145" as="geometry" />
        </mxCell>
        <mxCell id="eXjkPu2F_RSxJcqSW4fp-27" parent="ZPjAD2DASo2O7Q2uIRb9-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="busca imagens/vídeos" vertex="1">
          <mxGeometry height="30" width="140" x="280" y="1135" as="geometry" />
        </mxCell>
        <mxCell id="8cvuOirCfybw8arp-mBm-0" parent="ZPjAD2DASo2O7Q2uIRb9-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=light-dark(#100f0f, #ededed);align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;MELHORIA&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: bold; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px; color: rgb(0, 0, 0);&quot;&gt;Passo 1&lt;/span&gt;&lt;span style=&quot;font-weight: bold; color: rgb(187, 187, 187); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt; &lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Quando o usuário tenta carregar o seu newsfeed, uma requisição GET é enviada ao API gateway, no endpoint &quot;/v1/feed/{userId}&quot; — o mesmo que vimos na seção de design da API&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-weight: bold; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;Passo 2&lt;/span&gt;&lt;span style=&quot;font-weight: bold; color: rgb(187, 187, 187); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px; background-color: transparent;&quot;&gt;O API gateway recebe essa requisição e a encaminha para o NewsFeedReader service através do load balancer — um serviço especializado apenas em ler os newsfeeds.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px; background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-weight: bold; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;Passo 3&lt;/span&gt;&lt;span style=&quot;font-weight: bold; color: rgb(187, 187, 187); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px; background-color: transparent; color: rgb(0, 0, 0);&quot;&gt;O NewsFeedReader service busca o newsfeed já pré-construído no feeds cache. Como vimos no high-level design de criação de post, todo post é salvo no feedsDB e no feeds cache — então aqui o serviço só precisa buscar o newsfeed pré-pronto no cache.&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(187, 187, 187), rgb(76, 76, 76)); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px; font-weight: bold; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(187, 187, 187), rgb(76, 76, 76)); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px; font-weight: bold; background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-weight: bold; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;Passo 4&lt;/span&gt;&lt;span style=&quot;font-weight: bold; color: rgb(187, 187, 187); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px; font-weight: bold; background-color: transparent;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px; background-color: transparent; color: rgb(0, 0, 0);&quot;&gt;O NewsFeedReader service devolve o newsfeed ao usuário. Mas esse newsfeed contém apenas as URLs das imagens e vídeos dos posts, não os arquivos de mídia em si. Por isso, o cliente busca a imagem e o vídeo reais na CDN usando essas URLs; se o conteúdo não estiver na CDN, ela busca no object storage. Só então o usuário consegue ver o seu newsfeed completo.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="570" x="160" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="2T3yjdBV9X0LRPJmFuHs-0" parent="ZPjAD2DASo2O7Q2uIRb9-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font color=&quot;#080808&quot; style=&quot;font-size: 15px;&quot;&gt;Observação&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;font color=&quot;#080808&quot;&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;CDN (Content Delivery Network) é uma rede de servidores cache espalhados pelo mundo. Elas guardam cópias de conteúdos estáticos.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#080808&quot;&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#080808&quot;&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Pense&amp;nbsp; object storage como o armazém central. Elas existem pois o maior custo de entregar mídia é a distância física&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#080808&quot;&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="810" width="570" x="840" y="1260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="KxkG4HMcJO9KmGRm4wUU" name="Create Text Post">
    <mxGraphModel dx="1414" dy="791" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sLdT72pNXIufgefm2ZWe-1" edge="1" parent="1" source="sLdT72pNXIufgefm2ZWe-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="sLdT72pNXIufgefm2ZWe-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sLdT72pNXIufgefm2ZWe-2" connectable="0" parent="sLdT72pNXIufgefm2ZWe-1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="POST /v1/posts&lt;div&gt;(userId, text, hashtag)&lt;/div&gt;" vertex="1">
