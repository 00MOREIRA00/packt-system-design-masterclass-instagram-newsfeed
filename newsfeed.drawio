        <mxCell id="sLdT72pNXIufgefm2ZWe-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Post Writer Service" vertex="1">
